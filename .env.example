# Canonical account/OAuth origin and the separate forum origin. No trailing slash.
ACCOUNT_ORIGIN=https://techecho.org
FORUM_ORIGIN=https://forum.techecho.org

# Compatibility alias for older deployments. Keep it equal to ACCOUNT_ORIGIN.
APP_ORIGIN=https://techecho.org

# GitHub App OAuth credentials (server-side only).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate each value independently; keep them server-side.
# SESSION_SECRET: an independently generated secret containing at least 32 bytes.
SESSION_SECRET=
# TOKEN_ENCRYPTION_KEY: exactly 32 random bytes encoded as base64.
TOKEN_ENCRYPTION_KEY=

# Verified public identifiers for the Tech Echo forum source repository.
GITHUB_DISCUSSIONS_OWNER=Tech-Echo-Collective
GITHUB_DISCUSSIONS_REPO=Tech-Echo-Discussion
GITHUB_DISCUSSIONS_REPOSITORY_ID=1293776929

# Reserve permanent Member #001 for the founder's stable GitHub numeric ID.
FOUNDER_GITHUB_USER_ID=267296498
